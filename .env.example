# ==========================================================================
# Variáveis de ambiente — Chatbot/CRM Jurídico Dr. Jean Braz
# Copie este arquivo para .env.local e preencha os valores reais.
# NUNCA versione o arquivo .env.local nem exponha chaves secretas no client.
# ==========================================================================

# --- Supabase ---
# Públicas (podem ir para o client)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secreta (SOMENTE server-side — nunca prefixe com NEXT_PUBLIC)
SUPABASE_SERVICE_ROLE_KEY=

# --- Provedores de IA (escolha um ou mais; usados apenas no server) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Provedor padrão usado pela rota /api/chat (openai | anthropic | openrouter | google | mock)
AI_PROVIDER=mock
AI_MODEL=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Versão atual da Política de Privacidade (registrada no consentimento LGPD)
NEXT_PUBLIC_PRIVACY_POLICY_VERSION=1.0.0

# --- WhatsApp Cloud API (Meta) ---
# Token que você define no painel da Meta para verificar o webhook (GET).
WHATSAPP_VERIFY_TOKEN=
# App Secret do app da Meta — valida a assinatura X-Hub-Signature-256.
WHATSAPP_APP_SECRET=
# Token de acesso (System User ou temporário) para enviar mensagens.
WHATSAPP_ACCESS_TOKEN=
# ID do número de telefone do WhatsApp Business (Phone Number ID).
WHATSAPP_PHONE_NUMBER_ID=

# --- Instagram Messaging (Meta) — preparado para a próxima fase ---
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=

